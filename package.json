{
  "name": "@delva/dsh-ascend",
  "version": "0.1.0",
  "private": true,
  "description": "vLLM Ascend agent preset with GitHub MCP and a persistent Docker workspace",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delva0/dsh-ascend.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    ".": "./plugin/index.mjs"
  },
  "files": [
    "plugin",
    "assets",
    "prompts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "UPSTREAM.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test:dsh": "node tests/dsh.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.2"
  }
}
